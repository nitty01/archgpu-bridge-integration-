[Unit]
Description=ARCHGPU OLLAMA Bridge (user service)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/nitender-kumar/PROJECTS/PERSONAL/GIT/ARCHGPU_OLLAMA_BRIDGE
Environment=ARCHGPU_BRIDGE_LOG_LEVEL=INFO
Environment=ARCHGPU_BRIDGE_HOST=0.0.0.0
Environment=ARCHGPU_BRIDGE_PORT=8000
Environment=ARCHGPU_BRIDGE_REGISTRY_PATH=config/models.yaml
Environment=ARCHGPU_BRIDGE_STATE_PATH=data/runtime-state.json
Environment=ARCHGPU_BRIDGE_DYNAMIC_MODELS_PATH=data/downloaded_models.yaml
Environment=ARCHGPU_BRIDGE_BACKEND_MODELS_HOST_DIR=%h/llm/models
Environment=ARCHGPU_BRIDGE_BACKEND_STARTUP_TIMEOUT_SECONDS=300
Environment=ARCHGPU_BRIDGE_HF_INDEX_MODE=live_page
Environment=ARCHGPU_BRIDGE_HF_DISCOVERY_ENABLED=true
Environment=PYTHONPATH=.pkg:src
EnvironmentFile=-%h/.config/archgpu-bridge/environment
ExecStart=/usr/bin/python3 -m archgpu_ollama_bridge
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
